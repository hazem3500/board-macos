{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Board",
  "version": "0.1.0",
  "identifier": "cool.zem.board.mac",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "The oz-home Board on your Mac",
    "copyright": "oz-home",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": { "windowSize": { "width": 560, "height": 340 }, "appPosition": { "x": 150, "y": 170 }, "applicationFolderPosition": { "x": 410, "y": 170 } }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["board"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBQUNGQzZDMEJEODFEMEIKUldRTEhkZ0xiUHlzR3V6RlE5VTBKczllRUV0VFN6Ym91ZTNqN0tSOXBWN2s5eG9VbDlMeFZSQUoK",
      "endpoints": ["https://github.com/hazem3500/board-macos/releases/latest/download/latest.json"]
    }
  }
}
